{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "noUncheckedIndexedAccess": false,
    "outDir": "node_modules/.ts-dist/source",
    "rootDir": "src",
    "tsBuildInfoFile": "node_modules/.ts-dist/source.tsbuildinfo"
  },
  "include": ["src"],
  // Тексты деклараций ES для сценариев (#448): в программе ядра файл подменил бы глобальные типы;
  // импорты берут его объявление из libs.d.ts.
  "exclude": ["src/buff/workflow/libs.js"]
}
